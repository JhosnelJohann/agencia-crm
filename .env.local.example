# ============================================================
# GOZZ CRM — Overrides locales   (.env.local)
# ------------------------------------------------------------
# Capa opcional para sobrescribir valores del .env en tu máquina
# sin tocar el .env compartido. Mismo formato; solo pon aquí lo
# que quieras cambiar localmente.
#   cp .env.local.example .env.local
# El .env.local real NO se versiona (ver .gitignore).
# ============================================================

# --- Entorno / red ---
NODE_ENV=development
TZ=America/New_York
APP_URL=http://localhost:3300
API_URL=http://localhost:4300
FRONTEND_PORT=3300
API_PORT=4300
NEXT_PUBLIC_APP_URL=http://localhost:3300

# --- Base de datos ---
DATABASE_URL=postgresql://postgres:CAMBIAR_PASSWORD@localhost:5432/crm_staging
DB_SCHEMA=gozz

# --- Auth / criptografía ---
JWT_SECRET=CHANGE_ME_hex_largo_aleatorio
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
PII_ENCRYPTION_KEY=CHANGE_ME_clave_para_cifrar_PII
APP_ENC_KEY=CHANGE_ME_hex_de_32_bytes

# --- Super admin inicial ---
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_PASSWORD=CHANGE_ME

# --- Redis (opcional) ---
REDIS_URL=redis://127.0.0.1:6379/1

# --- Cookies / video ---
COOKIE_SECURE=false
NEXT_PUBLIC_JITSI_DOMAIN=meet.jit.si

# --- IA (opcional) ---
AI_URL=http://127.0.0.1:8300
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=


# --- LiveKit (opcional) ---
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://tu-dominio/livekit
LIVEKIT_HOST_URL=ws://localhost:7880

# --- Integraciones (opcional) ---

# --- n8n (webhook entrante de agentes IA) ---
N8N_WEBHOOK_SECRET=

# --- WhatsApp API oficial de Meta (Cloud API) ---
# Token que TÚ eliges y pegas en Meta al registrar el webhook; y el "App Secret" de tu app de Meta (firma de los eventos).
META_WA_VERIFY_TOKEN=
META_APP_SECRET=
